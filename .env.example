# ==============================================================================
# HERMES PRINT AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- LOCAL WHATSAPP GATEWAY (BAILEYS) ---
BAILEYS_API_URL=http://127.0.0.1:3001

# Nomor WhatsApp Admin untuk eskalasi revisi konten/desain dokumen (format internasional, e.g., 6281234567890)
ADMIN_WHATSAPP_NUMBER=6281234567890

# --- AI AGENT "HERMES" CONFIGURATION ---
# Pilihan provider AI: "deepseek", "gemini", atau "openai"
AI_PROVIDER=deepseek

# Konfigurasi OpenAI-Compatible Proxy (misal: 9Router di localhost:20128, Ollama, LM Studio, vLLM)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=your_openai_or_proxy_key_here
AI_MODEL=Kenari/deepseek-v4-1-flash:free

# Google Gemini API Key (Diisi jika AI_PROVIDER=gemini, dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# --- PRINT HARDWARE & SPOOLER CONFIGURATION ---
# Sistem Operasi host: "windows" atau "linux"
PRINTER_OS=windows

# Nama Printer Fisik (sesuai nama printer di Windows / CUPS)
# Kosongkan ("") untuk menggunakan default printer sistem operasi
PRINTER_NAME=

# Path ke executable SumatraPDF di Windows (otomatis diinstall oleh setup_pc_baru.bat)
# Contoh: C:\Users\lenov\AppData\Local\SumatraPDF\SumatraPDF.exe
SUMATRAPDF_PATH=C:\Users\lenov\AppData\Local\SumatraPDF\SumatraPDF.exe

# Mode Simulasi Cetak (True = testing tanpa mencetak fisik; False = mencetak riil via kabel USB)
PRINT_SIMULATION_MODE=True

# --- PRICING RULES (IDR) ---
# Tarif cetak per halaman (Hanya 3 kategori warna, tidak ada kategori hitam-putih)
PRICE_COLOR_LOW=2000
PRICE_COLOR_HIGH=2500
PRICE_COLOR_FULL=3000

# Profil Nama Percetakan / Usaha
STORE_NAME=Hermes Digital Print

# --- STORAGE & DATABASE ---
STORAGE_DIR=storage/temp_pdfs
DATABASE_PATH=storage/hermes.db

# --- SERVER NETWORK CONFIGURATION ---
HOST=0.0.0.0
PORT=8000
